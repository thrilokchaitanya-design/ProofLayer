# Copy to backend/.env for local overrides. Do not commit real credentials.
DATABASE_URL=sqlite:///./prooflayer.db
# For Vercel, attach Postgres and use its DATABASE_URL or POSTGRES_URL value.
# For durable PDFs on Vercel, connect a private Blob store in the project Storage tab.
STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173
OPENAI_API_KEY=
